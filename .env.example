# Network selection: testnet | mainnet  (start on testnet)
NETWORK=testnet

# Resource server RECEIVING address (your payTo).
#  - Testnet: any testnet account funded with ALGO and opted in to testnet USDC.
#  - Mainnet: your FIXED competition payTo address. Do NOT change it for the whole competition.
AVM_ADDRESS=

# Hosted GoPlausible facilitator (same URL for testnet and mainnet).
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Port for the paid resource server.
PORT=4021

# Comma-separated x402 endpoints your oracle observes and scores.
# Start with the Foundation's public example so real data flows from day one.
MONITOR_TARGETS=https://x402.goplausible.xyz/examples/weather

# How often the background monitor probes each target, in seconds.
MONITOR_INTERVAL_SECONDS=60

# Append-only observation history (compounding; cannot be backfilled — start early).
OBSERVATION_LOG=./data/observations.jsonl
